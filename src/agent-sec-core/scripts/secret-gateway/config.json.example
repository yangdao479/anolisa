{
  "schema_version": 1,
  "log_path": "/var/log/agent-sec/gateway.log",
  "daemon_socket": "/run/agent-sec-core/daemon.sock",
  "audit_timeout_ms": 800,
  "forwarding": {
    "mode": "uid",
    "agent_user": "REPLACE_WITH_THE_AGENT_USER",
    "listen_port": 18080,
    "ports": [80, 443],
    "manage_rules": true,
    "install_system_trust": true,
    "ca_readable_copy": true
  },
  "credentials": [
    {
      "id": "github-token",
      "fake_token": "ghp_REPLACEME0000000000000000000AGENTSEC",
      "real_token": "REPLACE_WITH_THE_REAL_GITHUB_TOKEN",
      "hosts": [
        "api.github.com"
      ],
      "header": "Authorization"
    },
    {
      "id": "gitee-token",
      "fake_token": "REPLACEME000000000000000AGENTSEC",
      "real_token": "REPLACE_WITH_THE_REAL_GITEE_TOKEN",
      "hosts": [
        "gitee.com"
      ],
      "location": "query",
      "param": "access_token"
    }
  ]
}
